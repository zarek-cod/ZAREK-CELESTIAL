-- ZAREK Divine Crown: local verification helper, NOT embedded in the accessory.
-- Run manually in Studio's Command Bar AFTER AFT generation.
-- Select exactly the generated Accessory and an R15 character Model.
-- No uploads, purchases, asset IDs or server publication are performed.
local Selection = game:GetService('Selection')
local accessory, character
for _, item in Selection:Get() do
    if item:IsA('Accessory') then accessory = item end
    if item:IsA('Model') and item:FindFirstChildOfClass('Humanoid') then character = item end
end
assert(accessory, 'Select the Accessory generated by AFT.')
assert(character, 'Also select an R15 character Model.')
local humanoid = character:FindFirstChildOfClass('Humanoid')
assert(humanoid.RigType == Enum.HumanoidRigType.R15, 'An R15 character is required.')
assert(accessory.AccessoryType == Enum.AccessoryType.Hat, 'AFT category must be Hat.')
local handle = accessory:FindFirstChild('Handle')
assert(handle and handle:IsA('MeshPart'), 'One MeshPart named Handle is required.')
local attachment = handle:FindFirstChild('HatAttachment')
assert(attachment and attachment:IsA('Attachment'), 'Generate HatAttachment through AFT.')
local meshes = 0
for _, item in accessory:GetDescendants() do
    assert(not item:IsA('LuaSourceContainer'), 'Remove all scripts from the Marketplace accessory.')
    if item:IsA('MeshPart') then meshes += 1 end
end
assert(meshes == 1, 'Exactly one MeshPart must be present.')
assert(handle.Transparency == 0, 'Transparency must be zero.')
assert(handle.Material == Enum.Material.Plastic, 'Use Plastic; PBR supplies the metal response.')
assert(handle.Color == Color3.new(1,1,1), 'MeshPart color must be white.')
local surface = handle:FindFirstChildOfClass('SurfaceAppearance')
assert(surface or handle.TextureID ~= '', 'A texture or SurfaceAppearance is required.')
if surface then
    assert(handle.TextureID == '', 'Clear legacy TextureID when SurfaceAppearance is used.')
    assert(surface.ColorMap ~= '', 'The PBR ColorMap is missing.')
end
local clone = accessory:Clone()
clone.Name = 'DivineCrown_LocalFit'
humanoid:AddAccessory(clone)
local h = clone:WaitForChild('Handle')
local head = character:FindFirstChild('Head')
local headHat = head and head:FindFirstChild('HatAttachment')
local crownHat = h:FindFirstChild('HatAttachment')
assert(headHat and crownHat, 'Both head and crown HatAttachments are required.')
task.wait()
local delta = headHat.WorldCFrame:ToObjectSpace(crownHat.WorldCFrame)
assert(delta.Position.Magnitude < .01, 'Attachment placement mismatch; inspect AFT placement.')
print('ZAREK LOCAL FIT: hierarchy and R15 attachment alignment passed.')
print('Offline source: 3672 triangles. This script does not inspect the uploaded mesh triangles.')
print('Marketplace moderation/validation, animations and hair/halo fit remain separate tests.')
return clone
